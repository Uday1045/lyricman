{
  "name": "lyrical-widget",
  "version": "1.0.0",
  "main": "main.js",
    "type": "module",

  "scripts": {
  "start": "electron .",
  "build": "electron-builder"
}
,
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.uday.spotifywidget",
    "productName": "Spotify Lyrical Widget",
    "directories": {
      "output": "dist"
    },
    "files": [
"main.js",
    "preload.js",
    "frontend/**/*",
    "/server/**/*",
    "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
